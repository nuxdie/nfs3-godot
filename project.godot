; Engine configuration file.
config_version=5

[application]

config/name="NFS3 Revival"
config/description="A Need for Speed III: Hot Pursuit style racer for Godot 4. Loads tracks and cars from your own NFS3 install."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="mobile"

anti_aliasing/quality/msaa_3d=2
textures/canvas_textures/default_texture_filter=1
